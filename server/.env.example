# Copy to .env on the VPS. Never commit .env.

POSTGRES_USER=selah
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=selah

# Random string used to sign session tokens (32+ chars).
TOKEN_SECRET=change_me_another_long_random

# SMTP via Nixihost mailbox (port 587).
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=mailbox_password
SMTP_FROM=Selah <noreply@yourdomain.com>

# Public site (no trailing slash).
PUBLIC_BASE_URL=https://selah.psithurismlabs.com

# Host port published only on localhost (must not clash with api/mcda).
SELAH_API_HOST_PORT=8091
