# Copy to .env on the VPS. Never commit .env.

POSTGRES_USER=selah
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=selah

# Random string used to sign session tokens (32+ chars).
TOKEN_SECRET=change_me_another_long_random

# SMTP via your mail host (port 587).
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=mailbox_password
SMTP_FROM=Selah <noreply@yourdomain.com>

# Public site (no trailing slash). Set to your real API host on the VPS only.
PUBLIC_BASE_URL=https://your-selah-host.example

# Host port published only on localhost (must not clash with other containers).
SELAH_API_HOST_PORT=8091

# Docker network your reverse proxy uses (must already exist). Leave blank default
# only if that network name matches; otherwise set it or remove proxy_net from compose.
SELAH_PROXY_NETWORK=son_default
